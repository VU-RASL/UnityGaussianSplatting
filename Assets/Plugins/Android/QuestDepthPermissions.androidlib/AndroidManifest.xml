<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="edu.vanderbilt.vurasl.gsac.depthpermissions"
          xmlns:tools="http://schemas.android.com/tools"
          xmlns:horizonos="http://schemas.horizonos/sdk">
  <application>
    <meta-data android:name="unityplayer.SkipPermissionsDialog"
               android:value="false"
               tools:replace="android:value" />
    <meta-data android:name="com.oculus.supportedDevices"
               android:value="quest3|quest3s"
               tools:replace="android:value" />
  </application>

  <uses-feature android:name="android.hardware.vr.headtracking"
                android:version="1"
                android:required="true" />
  <uses-feature android:name="com.oculus.feature.PASSTHROUGH"
                android:required="true" />
  <uses-feature android:name="oculus.software.handtracking"
                android:required="false" />

  <uses-permission android:name="com.oculus.permission.USE_SCENE" />
  <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

  <horizonos:uses-horizonos-sdk horizonos:minSdkVersion="68"
                                horizonos:targetSdkVersion="74" />
</manifest>
